{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
      "source": "~/.config/fastfetch/blackartix.txt",
      "color": {
          "1": "bright_red",
          "2": "light_red",
          "3": "bright_black"
      }
  },
  "display": {
    "color": {
      "title": "red",
      "keys": "red"
    },
    "size": {
      "binaryPrefix": "si"
    }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": " 󰣇  OS" },
    { "type": "board", "key": " 󰌢  Board" },
    { "type": "kernel", "key": " 󰌽  Kernel" },
    { "type": "uptime", "key": " 󰅐  Uptime" },
    { "type": "packages", "key": " 󰏖  Packages" },
    { "type": "command", "key": " 󰨊  Shell", "text": "pwsh -NoProfile -Command '$v=$PSVersionTable; $h=$v.GitCommitId.Split(\"-\")[-1].TrimStart(\"g\").Substring(0,7); \"PowerShell $($v.PSVersion) (g$h)\"'" },
    { "type": "wm", "key": " 󰍹  WM" },
    { "type": "terminal", "key": " 󰆍  Terminal" },
    { "type": "cpu", "key": " 󰻠  CPU" },
    { "type": "gpu", "key": " 󰢮  GPU", "format": "{name}" },
    { "type": "memory", "key": " 󰍛  Memory" },
    { "type": "swap", "key": " 󰓡  Swap" },
    { "type": "disk", "key": " 󰋊  Disk", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
    "separator",
    "break",
    "colors"
  ]
}

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
      "source": "~/.config/fastfetch/blackartix.txt",
      "color": {
          "1": "bright_red",
          "2": "light_red",
          "3": "bright_black"
      }
  },
  "display": {
    "color": {
      "title": "red",
      "keys": "red"
    },
    "size": {
      "binaryPrefix": "si"
    }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": " 󰣇  OS" },
    { "type": "board", "key": " 󰌢  Board" },
    { "type": "kernel", "key": "   Kernel" },
    { "type": "uptime", "key": " 󰅐  Uptime" },
    { "type": "packages", "key": " 󰏖  Packages" },
    { "type": "shell", "key": "   Shell", "format": "{exe-name}" },
    { "type": "wm", "key": "   WM" },
    { "type": "theme", "key": " 󰉼  Theme" },
    { "type": "icons", "key": " 󰀻  Icons" },
    { "type": "terminal", "key": "   Terminal" },
    { "type": "cpu", "key": "  CPU" },
    { "type": "gpu", "key": " 󰢮  GPU" },
    { "type": "memory", "key": " 󰍛  Memory" },
    { "type": "swap", "key": " 󰓡  Swap" },
    { "type": "disk", "key": " 󰋊  Disk", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "display", "key": " 󰍹  Display" },
    "separator",
    "break",
    "colors"
  ]
}
